# PostgreSQL
POSTGRES_USER=ims_user
POSTGRES_PASSWORD=ims_secret_2024
POSTGRES_DB=ims_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=ims_signals

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
RATE_LIMIT_PER_SECOND=15000
BUFFER_MAX_SIZE=50000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ─── Email / SMTP (Gmail) ───────────────────────────────────────────
# To enable real emails:
# 1. Enable 2FA on your Gmail: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Replace the values below with your Gmail address and the 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Email Recipients ──────────────────────────────────────────────
# For demo: you can set all three to the same Gmail inbox
ONCALL_EMAIL=
APP_TEAM_EMAIL=
SENIOR_EMAIL=

# ─── Escalation Settings ─────────────────────────────────────────
# Minutes before unacknowledged infra incident gets escalated
ESCALATION_TIMEOUT_MINUTES=5
# Minutes before investigating incident gets a reminder
REMINDER_TIMEOUT_MINUTES=30
